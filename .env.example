# API
PORT=8080
DATABASE_URL=postgres://finance_user:finance_pass@postgres:5432/finance_bot
DATABASE_URL_VPS=postgres://finance_user:finance_pass@postgres:5432/finance_bot
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AGENT_MODEL=gpt-4.1-mini
OPENAI_AGENT_TEMPERATURE=0.82
ADMIN_TOKEN=change-me
ADMIN_EMAIL=owner@finance-bot.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_JWT_SECRET=troque-este-segredo-jwt
ADMIN_JWT_EXPIRES_MINUTES=720
DEFAULT_TIMEZONE=America/Sao_Paulo

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TEMPLATE_SID=
TWILIO_TEMPLATE_OUTSIDE_24H_ENABLED=true

# Owner / Master mode (números separados por vírgula)
OWNER_WHATSAPP_NUMBERS=
OWNER_DAILY_REPORT_ENABLED=true
OWNER_DAILY_REPORT_HOUR=8
OWNER_DAILY_REPORT_MINUTE=5
PROACTIVE_AUTOMATION_ENABLED=true
PROACTIVE_AUTOMATION_INTERVAL_MINUTES=5
PROACTIVE_AUTOMATION_STARTUP_DELAY_SECONDS=20
PROACTIVE_AUTOMATION_CUSTOMER_LIMIT=1000

# Cost management (admin)
COST_USD_BRL_RATE=5.5
COST_OPENAI_MONTHLY_USD=0
COST_TWILIO_MONTHLY_USD=0
COST_SUPABASE_MONTHLY_USD=25
COST_INFRA_MONTHLY_USD=0
COST_OTHER_MONTHLY_USD=0

# Billing gateway (próxima etapa)
PAYMENT_GATEWAY=asaas
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com
ASAAS_WEBHOOK_TOKEN=

# Open Finance — Pluggy (https://pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
# URL pública da API (usada para montar o URL do webhook Pluggy)
API_PUBLIC_URL=https://sua-api.dominio.com

# Postgres
POSTGRES_DB=finance_bot
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass

# n8n (local)
