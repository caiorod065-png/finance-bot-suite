            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\": $json.to, \"type\":\"text\",\"text\":{\"body\": $json.replyText}}",
        "options": {}
      },
      "id": "SendWhatsapp",
      "name": "Send WhatsApp",
