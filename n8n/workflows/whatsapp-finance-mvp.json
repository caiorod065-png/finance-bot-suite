      "typeVersion": 4.2,
      "position": [
        460,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !!$json.replyText && !!$json.to }}",
              "value2": true
            }
          ]
        }
      },
      "id": "ShouldReply",
      "name": "Should Reply?",
      "type": "n8n-nodes-base.if",
